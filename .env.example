# ============================================================
# 必填：後端服務 URL + Internal Key
# ============================================================
# 這些變數在 nuxt.config.ts 中預設為空字串，未設定時 API 代理呼叫會失敗。

# GIF 轉檔服務的 Cloud Run URL（對應 runtimeConfig.gifServiceUrl）
NUXT_GIF_SERVICE_URL=https://your-gif-service.a.run.app

# PNG to Spritesheet 服務的 Cloud Run URL（對應 runtimeConfig.png2ssServiceUrl）
NUXT_PNG2SS_SERVICE_URL=https://your-png2ss-service.a.run.app

# UniIMGC（萬象圖片轉換器）的 Cloud Run URL（對應 runtimeConfig.uniimgcServiceUrl）
NUXT_UNIIMGC_SERVICE_URL=https://your-uniimgc-service.a.run.app

# 共用的 Internal Key（三個 Cloud Run 服務共用同一把 X-Internal-Key）
NUXT_INTERNAL_KEY=your-internal-key

# ============================================================
# 選填：Monetag / 廣告設定覆寫
# ============================================================
# 以下所有 NUXT_PUBLIC_* 變數在 nuxt.config.ts 中都有硬編碼的正式值
# （見 runtimeConfig.public）。未設定時會沿用程式碼內預設值，正式環境可直接省略。
# 只有在以下情境才需要覆寫：
#   - 切換廣告供應商或關閉特定版位（把 SRC 設為空字串）
#   - 測試不同 zone ID
#   - 本地開發想關廣告（NUXT_PUBLIC_AD_PROVIDER=none）

# 廣告供應商：'adsense' | 'monetag' | 'none'
# 設為 none 可關閉所有廣告（AdSense 複查期間建議使用）
# NUXT_PUBLIC_AD_PROVIDER=monetag

# AdSense 客戶端 ID（provider=adsense 時使用）
# NUXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6385934484512467

# Monetag Multitag（provider=monetag 時使用）
# NUXT_PUBLIC_MONETAG_MULTITAG_SRC=https://quge5.com/88/tag.min.js
# NUXT_PUBLIC_MONETAG_MULTITAG_ZONE=228851

# Monetag Push Notifications（zone 已內嵌於 URL ?z= 參數）
# 把 SRC 設為空字串可同時停用 head tag 注入與 /sw.js（會自動改送墓碑 SW）
# NUXT_PUBLIC_MONETAG_PUSH_SRC=https://5gvci.com/act/files/tag.min.js?z=10864789
# NUXT_PUBLIC_MONETAG_PUSH_ZONE=

# Monetag Push Notifications Service Worker 設定（由 /sw.js 動態 server route 使用）
# NUXT_PUBLIC_MONETAG_PUSH_SW_DOMAIN=3nbf4.com
# NUXT_PUBLIC_MONETAG_PUSH_SW_ZONE_ID=10864789

# Monetag In-Page Push（浮動式 native banner，把 SRC 設為空字串可停用）
# NUXT_PUBLIC_MONETAG_INPAGE_PUSH_SRC=https://nap5k.com/tag.min.js
# NUXT_PUBLIC_MONETAG_INPAGE_PUSH_ZONE=10864907

# Monetag Vignette Banner（插頁式強制顯示，侵略性較高，把 SRC 設為空字串可停用）
# NUXT_PUBLIC_MONETAG_VIGNETTE_SRC=https://n6wxm.com/vignette.min.js
# NUXT_PUBLIC_MONETAG_VIGNETTE_ZONE=10864918

# Monetag Direct Link（等待室下載按鈕並行開啟用）
# NUXT_PUBLIC_MONETAG_DIRECT_LINK=https://omg10.com/4/10864766

# Monetag Direct Link 備用（未來版位用，目前未啟用）
# NUXT_PUBLIC_MONETAG_DIRECT_LINK_ALT=https://omg10.com/4/10864781
